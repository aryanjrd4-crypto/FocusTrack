{
  "manifest_version": 3,
  "name": "FocusTrack",
  "version": "1.1",
  "description": "Track your browsing focus & earn points",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*",
    "https://focustrack-4psp.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusTrack"
  }
}